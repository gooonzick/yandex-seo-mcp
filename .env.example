# Use service-specific tokens when permissions differ.
YANDEX_METRICA_TOKEN=
YANDEX_WEBMASTER_TOKEN=

# Optional fallback used by both services.
YANDEX_OAUTH_TOKEN=

YANDEX_HTTP_TIMEOUT_MS=30000
YANDEX_HTTP_MAX_RETRIES=3
YANDEX_MAX_RESULT_ROWS=1000
YANDEX_MAX_RESULT_BYTES=500000
ENABLE_WRITE_TOOLS=false

# stdio (default) or http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
# Required when exposing HTTP beyond a trusted local machine.
MCP_HTTP_BEARER_TOKEN=

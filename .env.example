# Use service-specific tokens when permissions differ.
YANDEX_METRICA_TOKEN=
YANDEX_WEBMASTER_TOKEN=

# Optional fallback used by both services.
YANDEX_OAUTH_TOKEN=

YANDEX_HTTP_TIMEOUT_MS=30000
YANDEX_HTTP_MAX_RETRIES=3
YANDEX_HTTP_MAX_CONCURRENCY=8
YANDEX_HTTP_CACHE_TTL_MS=30000
YANDEX_MAX_RESULT_ROWS=1000
YANDEX_MAX_RESULT_BYTES=500000

MONITOR_STORAGE_PATH=.yandex-seo-monitor.json
MONITOR_RETENTION_DAYS=90
MONITOR_INTERVAL_MS=0
MONITOR_TARGETS_JSON=[]

CRAWLER_MAX_PAGES=200
CRAWLER_MAX_DEPTH=5
CRAWLER_TIMEOUT_MS=15000
CRAWLER_MAX_BODY_BYTES=2000000
CRAWLER_CONCURRENCY=4
CRAWLER_DELAY_MS=0
CRAWLER_USER_AGENT=YandexSeoMcpBot/1.0
CRAWLER_SNAPSHOT_RETENTION_DAYS=90
CRAWLER_SNAPSHOT_MAX_RUNS=100
CRAWLER_SNAPSHOT_QUERY_DENYLIST=access_token,api_key,apikey,auth,authorization,code,credential,key,password,secret,session,sessionid,sid,token
CRAWLER_REGRESSION_EXCLUSIONS_JSON=[]

QUERY_CLUSTER_THRESHOLD=0.42
QUERY_MAX_QUERIES=500

# stdio (default) or http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_RATE_LIMIT_PER_MINUTE=120
# Required when exposing HTTP beyond a trusted local machine.
MCP_HTTP_BEARER_TOKEN=

# Optional multi-user Authorization Code + PKCE deployment.
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_REDIRECT_URI=
# At least 32 characters; keep outside version control.
YANDEX_OAUTH_STORAGE_KEY=
YANDEX_OAUTH_STORAGE_PATH=.yandex-seo-oauth.enc
